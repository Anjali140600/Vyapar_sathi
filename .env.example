DATABASE_URL=mysql://root:sql%4012%2334@localhost:3306/mydb
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Choose "groq" for the cloud-hosted model or "ollama" for local testing.
LLM_PROVIDER=groq

# Groq cloud configuration (required when LLM_PROVIDER=groq).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Local Ollama configuration (used only when LLM_PROVIDER=ollama).
OLLAMA_MODEL=tinyllama
