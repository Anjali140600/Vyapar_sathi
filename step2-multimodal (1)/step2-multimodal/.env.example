PORT=3100

# If Node cannot find whisper/python (ENOENT), set conda base — same as: conda info --base
# CONDA_PREFIX=C:\Users\YOU\Anaconda3

# Tesseract languages (e.g. eng, hin, eng+hin for English + Hindi)
TESSERACT_LANGS=eng+hin

# Whisper model: tiny (~75MB), base (~140MB), small (~460MB), medium, large
WHISPER_MODEL=base

# Optional: cache Whisper model files here if C: is full (create folder first)
# WHISPER_MODEL_DIR=D:\whisper-models

# Optional: full path to whisper executable if not on PATH (Windows: ...\Scripts\whisper.exe)
# WHISPER_CMD=

# Optional: full path to python.exe that has openai-whisper (tried first before `py` / `python`)
# WHISPER_PYTHON=C:\Users\YOU\Anaconda3\python.exe

# CPU: use false. GPU: can try true
WHISPER_FP16=false

# Force spoken language so short browser clips are not mis-detected (e.g. Swedish). Use "auto" to let Whisper guess.
WHISPER_LANGUAGE=en

# Optional: nudges Whisper for English names / Hinglish (helps live mic clips)
# WHISPER_INITIAL_PROMPT=English conversation, Indian names.
